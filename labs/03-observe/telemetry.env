# Lab 3 — router telemetry settings. `./lab run` passes these to the router.

# Send traces to otel-tui (start it in a second terminal with: ./lab otel)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export spans quickly — great for a workshop, too chatty for production.
OTEL_BSP_SCHEDULE_DELAY=500
# Metrics stay on the router's Prometheus endpoint: http://localhost:1064/metrics
OTEL_METRICS_EXPORTER=none

# ✏️ Modify, step 2 — map the x-agent-id header to an `agent.id` attribute on
# spans, metrics and access-log lines. Uncomment:
# OTEL_AIGW_REQUEST_HEADER_ATTRIBUTES=x-agent-id:agent.id

# 🛠 Stretch — switch MCP spans to the OpenTelemetry GenAI/MCP semantic
# conventions (span names become "tools/call <tool>"). Uncomment, ./lab run, compare:
# AI_GATEWAY_TRACING_SEMCONV=gen_ai
